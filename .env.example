# MySQL / XAMPP Configuration
# The MySQL server must be running in XAMPP (default port 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sentinel

# Create the database in phpMyAdmin or MySQL CLI before starting:
#   CREATE DATABASE sentinel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# Google AI (Optional - for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
